# Copy to .env in this folder. Do not commit .env.
# Restart the dev server after changing this file.

# The top-left picker reads models.json (copy models.example.json).
# These values are used only when that list is missing.
# Point a cloud model at a key with apiKeyEnv. Keep the key in this file.
CHAT_PROVIDER=ollama

OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

GEMINI_API_KEY=
GROQ_API_KEY=
